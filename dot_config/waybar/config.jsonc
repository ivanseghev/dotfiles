// -*- mode: jsonc -*-
[
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // "height": 41, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 2, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/rofi",
        "custom/chrome",
        "custom/noi",
        "custom/screenshot",
        "custom/translate",
        "custom/dictate",
        "custom/wordpress",
        "sway/mode",
        "sway/scratchpad"
        // "custom/media"
    ],
    // "modules-left": ["custom/rofi", "custom/chrome", "custom/noi", "custom/rednotebook", "custom/foliate", "custom/screenshot", "custom/translate", "custom/dictate", "custom/wordpress", "custom/vifm", "custom/aerc"],
    "modules-center": [
        // "sway/window"
        "sway/workspaces"
        // "niri/workspaces"
        // "cffi/niri-taskbar"
        // "cffi/niri-workspaces-enhanced"
    ],
    "modules-right": [
        // "mpd",
        // "idle_inhibitor",
        // "custom/remontoire",
        "custom/3dprint",
        "custom/kdeconnect",
        "custom/display",
        "custom/kindle",
        "custom/bluetooth",
        "pulseaudio",
        // "network",
        // "power-profiles-daemon",
        // "cpu",
        // "memory",
        // "temperature",
        // "backlight",
        // "keyboard-state",
        // "sway/language",
        "custom/separator",
        "clock",
        "custom/separator",
        "tray"
        // "custom/power"
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "niri/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "cffi/niri-taskbar": {
        "module_path": "/usr/lib/waybar/libniri_taskbar.so",
        "module_name": "niri_taskbar"
    },
    "cffi/niri-workspaces-enhanced": {
      "module_path": "/usr/lib/waybar/libwaybar_niri_workspaces_enhanced.so",
      "format": "{index-and-name}{separator}{window-icons}",
      "window-icon-format": {
        "default": "{icon}",
        "urgent": "<span foreground='red'>{icon}</span>",
         "focused": "<span foreground='#6790eb'>{icon}</span>"
      },
      "window-icons": {
        "com.mitchellh.ghostty": "",
        "darktable": "",
        "foot": "",
        "google-chrome": ""
      },
      "window-icon-default": "*"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/language": {
        "format": "{}",
        "tooltip": false,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 22, // Matches your Polybar tray-size 
        "spacing": 8,
        "show-passive-items": true
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%a, %d %b, %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/separator": {
        "format": " | "
    },
    "custom/rofi": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun",
        "on-click-right": "xfce4-appfinder"
    },
    "custom/chrome": {
        "format": "",
        "tooltip": false,
        "on-click": "google-chrome-stable"
    },
    "custom/noi": {
        "format": "󰟍",
        "tooltip": false,
        "on-click": "noi-desktop"
    },
    "custom/translate": {
        "format": "",
        "tooltip": false,
        "on-click": "~/Bin/translate-rofi.sh",
        "on-click-middle": "alacritty -e nvim ~/Bin/translate-rofi.sh"
    },
    "custom/dictate": {
        "format": "󰔊",
        "tooltip": false,
        "on-click": "~/Bin/dictate-whisper-continuous.sh -l ru",
        "on-click-middle": "alacritty -e nvim ~/Bin/dictate-whisper-continuous.sh",
        "on-click-right": "~/Bin/dictate-whisper-continuous.sh -l en"
    },
    "custom/screenshot": {
        "format": "",
        "tooltip": false,
        "on-click": "flameshot gui"
    },
    "custom/wordpress": {
        "format": "",
        "tooltip": false,
        "on-click": "alacritty -e ~/Bin/wp_clean.sh"
    },
    "custom/bluetooth": {
        "format": "󰂯",
        "tooltip": false,
        "on-click": "alacritty -e bluetuith"
    },
    "custom/remontoire": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/sway/scripts/remontoire_keybinding_viewer.sh",
        "on-click-middle": "alacritty -e nvim ~/.config/sway/scripts/remontoire_keybinding_viewer.sh",
    },
    "custom/3dprint": {
        "format": "󰹜",
        "tooltip": false,
        "on-click": "~/Bin/3dprint.sh",
        "on-click-middle": "alacritty -e nvim ~/Bin/3dprint.sh"
    },
    "custom/kdeconnect": {
        "format": "",
        "tooltip": false,
        "on-click": "~/Bin/kdeconnect.sh --menu",
        "on-click-middle": "alacritty -e nvim ~/Bin/kdeconnect.sh",
        "on-click-right": "~/Bin/kdeconnect.sh --device-menu"
    },
    "custom/kindle": {
        "format": "󱚄",
        "tooltip": false,
        "on-click": "alacritty -e ~/Bin/send_to_kindle.sh",
        "on-click-middle": "alacritty -e nvim ~/Bin/send_to_kindle.sh"
    },
    "custom/display": {
        "format": "冷",
        "tooltip": false,
        "on-click": "~/Bin/display-manager-sway.sh",
        "on-click-middle": "alacritty -e nvim ~/Bin/display-manager-sway.sh"
    }
  },
  {
        "layer": "top",
        "position": "bottom",
        // "height": 30,
        // "modules-left": ["custom/cylon", "idle_inhibitor", "mpd"],
        "modules-left": ["custom/pacui", "custom/separator", "custom/updates", "custom/separator", "mpd"],
        "modules-center": ["custom/systemctl-tui", "custom/separator", "custom/rofi-tmux", "custom/separator", "custom/notes"],
        "modules-right": [
            "temperature",
            "cpu",
            "memory",
            "disk",
            "custom/separator",
            "custom/weather",
            "custom/separator",
            "sway/language",
            // "niri/language",
            "custom/separator",
            "custom/wlogout"
        ],
        "mpd": {
            "server": "192.168.1.11",
            "port": 6600,
            "format": "{artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ({songPosition}|{queueLength}) {volume}% ",
            "format-disconnected": "Disconnected ",
            "format-stopped": "Stopped ",
            "unknown-tag": "N/A",
            "interval": 5,
            "on-click": "alacritty -T \"ncmpc\" --class \"mpd\" -e ncmpc",
            "consume-icons": {
                "on": " "
            },
            "random-icons": {
                "off": "<span color=\"#f53c3c\"></span> ",
                "on": " "
            },
            "repeat-icons": {
                "on": " "
            },
            "single-icons": {
                "on": "1 "
            },
            "state-icons": {
                "paused": "",
                "playing": ""
            },
            "tooltip-format": "MPD (connected)",
            "tooltip-format-disconnected": "MPD (disconnected)"
        },
        "cpu": {
            "interval": 60,
            "format": ": {usage}%"
        },
        "disk": {
	        "interval": 3600,
            "format": "󰋊: {percentage_used}%"
        }, 

        "memory": {
            "interval": 30,
            "format": ": {percentage}%",
            "on-click": "alacritty -e htop -s PERCENT_MEM"
        },

        "custom/notes": {
            "format": "",
            "tooltip": false,
            "on-click": "alacritty -e tjournal"
        },
        "custom/systemctl-tui": {
            "format": "",
            "tooltip": false,
            "on-click": "alacritty -e systemctl-tui",
        },
        "custom/rofi-tmux": {
            "format": "",
            "tooltip": false,
            "on-click": "~/.config/sway/scripts/rofi-tmux.sh",
        },

        "temperature": {
            "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon1/temp1_input",
            "critical-threshold": 70,
            "format": "{icon} {temperatureC}°C",
            "format-icons": ["", "", "", "", ""]
        },
        "custom/separator": {
            "format": " | "
        },
        "custom/pacui": {
            "format": "󱙝",
            "tooltip": false,
            "on-click": "alacritty -e pacui"
        },
        "custom/updates": {
            "format": "{icon} {0}",
            "return-type": "json",
            "format-icons": {
            "has-updates": "󱍷",
            "updated": "󰂪"
            },
            "exec-if": "which waybar-module-pacman-updates",
            "exec": "waybar-module-pacman-updates --interval-seconds 3600 --network-interval-seconds 3600"
        },
        "custom/weather": {
            "exec": "~/.config/sway/scripts/openweathermap-fullfeatured.sh",
            "interval": 3600,
            "format":  "{text}",
            "tooltip": false
        },
        "custom/wlogout": {
            "format": " ",
            "tooltip": false,
            "on-click": "wlogout -c 5 -r 5 -p layer-shell",
            "on-click-right": "wlogout -c 5 -r 5 -p layer-shell"
        }
    }
]

