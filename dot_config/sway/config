bindsym $mod+F6 exec --no-startup-id mpc stop
bindsym $mod+F7 exec --no-startup-id mpc prev
bindsym $mod+F8 exec --no-startup-id mpc toggle
bindsym $mod+F9 exec --no-startup-id mpc next

# drop down terminal
